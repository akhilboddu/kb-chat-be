# LLM Configuration
GOOGLE_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=your_anthropic_key
# COHERE_API_KEY=your_cohere_key  # DEPRECATED: Migrated to HuggingFace embeddings

# Embeddings Configuration
# Enable flexible embeddings system (REQUIRED for HuggingFace)
USE_FLEXIBLE_EMBEDDINGS=true
# Options: huggingface (recommended), openai, cohere (deprecated)
EMBEDDINGS_PROVIDER=huggingface
# HuggingFace model to use - 1024-dimensional models recommended
# Options: mixedbread-ai/mxbai-embed-large-v1 (recommended), dunzhang/stella_en_1.5B_v5, BAAI/bge-large-en-v1.5
HUGGINGFACE_MODEL=mixedbread-ai/mxbai-embed-large-v1
# Optional HuggingFace token for private/gated models
# HF_TOKEN=your_huggingface_token_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# PayStack Payment Integration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# AWS SES Email Configuration
SES_ACCESS_KEY=your_aws_access_key
SES_SECRET_ACCESS_KEY=your_aws_secret_key
SES_REGION=your_aws_region
SENDER_EMAIL=your_sender_email

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Worker Safety Configuration (CRITICAL for preventing segfaults with ML models)
CELERY_WORKER_POOL=threads
CELERY_CONCURRENCY=2
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Task Time Limits
UPLOAD_SOFT_LIMIT=1800  # 30 minutes soft limit for upload tasks
UPLOAD_HARD_LIMIT=2400  # 40 minutes hard limit for upload tasks
SCRAPE_SOFT_LIMIT=600   # 10 minutes soft limit for scrape tasks
SCRAPE_HARD_LIMIT=900   # 15 minutes hard limit for scrape tasks

# HuggingFace Configuration
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_OFFLINE=0
# Optional: Custom cache directory for transformers
# TRANSFORMERS_CACHE=/path/to/cache/dir

# Application Settings
BASE_URL=https://yourdomain.com
VITE_BASE_URL=https://your-frontend-url.com
CORS_ORIGINS=https://example.com,https://app.example.com
EXPIRY_STATUS_TIME=300

# Database Configuration
SQLITE_DB_DIR=./db
SQLITE_DB_FILENAME=kb_metadata.sqlite

# Feature Flags
USE_CELERY=true